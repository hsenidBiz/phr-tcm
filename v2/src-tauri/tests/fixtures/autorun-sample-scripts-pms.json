          { "kind": "check_url", "contains": "/goalcascading" }
        ]
      },
      {
        "step_number": 2,
        "actions": [
          { "kind": "wait_for", "selector": "#goal-cascading-okr, #goal-cascading-bsc", "timeout_ms": 20000 }
