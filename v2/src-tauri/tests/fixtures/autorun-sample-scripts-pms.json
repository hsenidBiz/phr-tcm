[
  {
    "case_id": 100001,
    "title": "SAMPLE A - Company Objective page loads with its cycle and objective count",
    "steps": [
      {
        "step_number": 1,
        "actions": [
          { "kind": "navigate", "url": "http://localhost:5000/companyobjective" },
          { "kind": "wait_for", "selector": "#dco-cycle-name", "timeout_ms": 15000 },
          { "kind": "check_text", "value": "Strategic Objectives" }
        ]
      },
      {
        "step_number": 2,
        "actions": [
          { "kind": "wait_for", "selector": "#dco-count", "timeout_ms": 15000 },
          { "kind": "check_url", "contains": "/companyobjective" }
        ]
      }
    ]
  },
  {
    "case_id": 100002,
    "title": "SAMPLE B - Add Objective opens its modal from the Company Objective page",
    "steps": [
      {
        "step_number": 1,
        "actions": [
          { "kind": "navigate", "url": "http://localhost:5000/companyobjective" },
          { "kind": "wait_for", "selector": "#dco-cycle-name", "timeout_ms": 15000 }
        ]
      },
      {
        "step_number": 2,
        "actions": [
          { "kind": "wait_for", "selector": "#dco-add-btn-host-button", "timeout_ms": 15000 },
          { "kind": "click", "selector": "#dco-add-btn-host-button" },
          { "kind": "wait_for", "selector": "#mdlAddObjective-title", "timeout_ms": 10000 },
          { "kind": "check_text", "value": "Add Objective" }
        ]
      },
      {
        "step_number": 3,
        "actions": [
          { "kind": "wait_for", "selector": "#dco-objective-title-field-input", "timeout_ms": 10000 },
          { "kind": "fill", "selector": "#dco-objective-title-field-input", "value": "Auto Run smoke objective" },
          { "kind": "check_text", "value": "Auto Run smoke objective" }
        ]
      }
    ]
  },
  {
    "case_id": 100003,
    "title": "SAMPLE C - Manager wizard opens on the Goals step for a given employee",
    "steps": [
      {
        "step_number": 1,
        "actions": [
          {
            "kind": "navigate",
            "url": "http://localhost:5000/performanceassessment/managerwizard?cycleId=REPLACE_CYCLE_ID&stageId=REPLACE_STAGE_ID&employeeNumber=REPLACE_EMP&actingRole=manager&stepKey=goals"
          },
          { "kind": "wait_for", "selector": "#paWizardContent", "timeout_ms": 20000 },
          { "kind": "check_url", "contains": "stepKey=goals" }
        ]
      },
      {
        "step_number": 2,
        "actions": [
          { "kind": "wait_for", "selector": "#mga-mgr-rating-number", "timeout_ms": 20000 },
          { "kind": "check_text", "value": "Goal Rating" }
        ]
      },
      {
        "step_number": 3,
        "actions": [
          { "kind": "wait_for", "selector": "#paBtnContinue-button", "timeout_ms": 10000 },
          { "kind": "check_text", "value": "Continue" }
        ]
      }
    ]
  },
  {
